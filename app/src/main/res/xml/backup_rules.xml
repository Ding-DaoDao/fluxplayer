<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules (API <= 30)：排除含云盘凭证/密码的 SharedPreferences 与 DataStore 文件，
   避免凭证通过 Google Auto Backup 外泄。
-->
<full-backup-content>
    <exclude domain="sharedpref" path="openlist_prefs.xml"/>
    <exclude domain="sharedpref" path="alipan.xml"/>
    <exclude domain="sharedpref" path="cloud189.xml"/>
    <exclude domain="sharedpref" path="pan123.xml"/>
    <exclude domain="sharedpref" path="quark.xml"/>
    <exclude domain="sharedpref" path="uc.xml"/>
    <exclude domain="sharedpref" path="yun139.xml"/>
    <exclude domain="file" path="datastore/webdav_servers.json"/>
    <exclude domain="file" path="datastore/backup_webdav.json"/>
</full-backup-content>
